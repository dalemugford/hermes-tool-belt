#!/bin/sh
# Public Tool Belt command launcher. Select the same Python environment Hermes
# uses, then execute the importable CLI module without loading plugin hooks.
set -e

_TOOL_BELT_DIR=$(CDPATH= cd -P "$(dirname "$0")" >/dev/null 2>&1 && pwd)

if [ -n "${HERMES_PYTHON:-}" ] && [ ! -x "$HERMES_PYTHON" ] \
   && ! command -v "$HERMES_PYTHON" >/dev/null 2>&1; then
  printf "%s\n" "tool-belt: HERMES_PYTHON ($HERMES_PYTHON) is not executable; falling back" >&2
fi

# ${HOME} can be unset (cron, some CI containers); don't collapse to "/.hermes".
_HERMES_HOME=${HERMES_HOME:-${HOME:-/nonexistent}/.hermes}

if [ -n "${HERMES_PYTHON:-}" ] && { [ -x "$HERMES_PYTHON" ] || command -v "$HERMES_PYTHON" >/dev/null 2>&1; }; then
  _TOOL_BELT_PYTHON=$HERMES_PYTHON
elif [ -x "$_HERMES_HOME/hermes-agent/venv/bin/python3" ]; then
  _TOOL_BELT_PYTHON=$_HERMES_HOME/hermes-agent/venv/bin/python3
elif [ -x "$_TOOL_BELT_DIR/../../hermes-agent/venv/bin/python3" ]; then
  _TOOL_BELT_PYTHON=$_TOOL_BELT_DIR/../../hermes-agent/venv/bin/python3
elif [ -x "$_TOOL_BELT_DIR/.venv/bin/python3" ]; then
  _TOOL_BELT_PYTHON=$_TOOL_BELT_DIR/.venv/bin/python3
elif command -v python3 >/dev/null 2>&1; then
  _TOOL_BELT_PYTHON=python3
else
  printf "%s\n" "tool-belt: Python 3 not found; set HERMES_PYTHON to the Hermes interpreter" >&2
  exit 127
fi

exec "$_TOOL_BELT_PYTHON" "$_TOOL_BELT_DIR/savings_cli.py" "$@"
